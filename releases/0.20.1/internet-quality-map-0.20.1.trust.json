  "permissions": {
    "network": [
      "Three temporary exclusive loopback listeners during authorized measurement on macOS/Linux; no listeners for effect-free or comparison-only commands",
      "Authenticated bounded loopback TCP to one existing everyday helper for settled load exclusion; never starts a helper",
      "HTTPS requests to speed.cloudflare.com for tests",
      "DNS lookup for route observation",
      "HTTPS requests to the selected IQM origin for publication or status checks",
      "Opt-in credential-free comparison GETs, serial 5-second requests within 20 seconds; one 64 KiB context response and 1-3 512 KiB pages per scope",
      "Everyday-only credential-free GETs, serial 5-second requests within 20 seconds; one optional 64 KiB context response and one immutable 512 KiB snapshot per scope; no retries or pagination"
    ],
    "filesystem": [
      "Read one private everyday installation locator only when a test starts; never reads its reporting credential or SQLite state",
      "Read OS route and host facts",
      "Create a new private output file only when --output is supplied"
    ],
    "subprocess": "Fixed OS utilities without a shell, no elevation; --no-network-detection disables observation.",
    "installation": "No install scripts, automatic updates, hooks or background services."
  },
  "helper_permissions": {
    "network": [
      "Three temporary exclusive loopback listeners for installation selection, owner startup and enabling operations",
      "Authenticated loopback owner control",
      "Explicit scoped private enrollment, report, permit, and revoke HTTPS operations",
      "Separately consented public quality grant, withdrawal and exact reconciliation HTTPS operations",
      "Permit-only small HTTPS response timing every five seconds while running"
    ],
    "filesystem": [
      "Explicit private SQLite installation and retained evidence at the canonical user path",
      "Private pinned helper and Node copies, supplied trust-v2 sidecar, bounded lifecycle journal and exact per-user LaunchAgent definition"
    ],
    "subprocess": [
      "Cancelable DNS resolver",
      "Separately consented fixed selected-interface counter readers",
      "Bounded supplied and copied Node/helper version checks",
      "Explicit fixed per-user launchctl bootstrap and bootout without a shell or elevation"
    ],
    "installation": "Explicit macOS login install, local pinned update and retained uninstall. Continuing monitoring needs separate consent. No downloads or automatic updates.",
    "public_quality": "Explicit separate permission only; uncertain grants and withdrawal remain durable"
  },
  "limits": [
    "A same-origin checksum does not authenticate the publisher independently.",
    "This build record is generated evidence, not a signed supply-chain attestation.",
    "A normal Node process has the permissions of its user."
  ]
